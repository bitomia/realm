{
  "name": "@realm/client",
  "version": "0.1.0",
  "description": "Client for Realm clusters",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "prepare": "pnpm build",
    "lint": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.4",
    "@types/node": "^26.6.5",
    "typescript": "~6.0.2",
    "unplugin-dts": "^1.1.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
