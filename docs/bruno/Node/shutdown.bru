meta {
  name: Shutdown Node
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/node/shutdown
  body: json
  auth: inherit
}

body:json {
  {
    "wall_message": "Shutting down for maintenance",
    "time": 60,
    "node_name": "node-1"
  }
}

docs {
  dto.ShutdownNodeRequest. `time` is the delay in seconds, `node_name` is
  optional (omit to target this node).
}
