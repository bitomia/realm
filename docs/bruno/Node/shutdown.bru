meta {
  name: Shutdown Node
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/node/shutdown
  body: json
  auth: inherit
}

body:json {
  {
    "wall_message": "Shutting down for maintenance",
    "time": 60
  }
}

docs {
  dto.ShutdownNodeRequest. `time` is the delay in seconds. Targets this node; use
  `POST /node/guests/{guestName}/shutdown` for a guest node.
}
