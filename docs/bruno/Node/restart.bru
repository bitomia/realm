meta {
  name: Restart Node
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/node/restart
  body: json
  auth: inherit
}

body:json {
  {
    "wall_message": "Rebooting",
    "time": 60
  }
}

docs {
  dto.RestartNodeRequest. `time` is the delay in seconds. Targets this node; use
  `POST /node/guests/{guestName}/restart` for a guest node.
}
